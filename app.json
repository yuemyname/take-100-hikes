{
  "expo": {
    "name": "100PEAKS",
    "slug": "100peaks",
    "version": "0.1.0",
    "scheme": "hundredpeaks",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hundredpeaks.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "정상 인증을 위해 현재 위치가 필요해요.",
        "NSCameraUsageDescription": "정상 인증 사진을 촬영하기 위해 카메라가 필요해요.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "G5MH3Q5HFP"
    },
    "android": {
      "package": "com.hundredpeaks.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFF9ED",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/wordmark-color.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#FFF9ED"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "정상 인증을 위해 현재 위치가 필요해요."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "정상 인증 사진을 촬영하기 위해 카메라가 필요해요."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "프로필 사진과 홈 산 배경을 선택하기 위해 사진 보관함 접근이 필요해요.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "294a5423-7eb4-447a-91ec-e671b2c4a100"
      }
    },
    "owner": "yueeee"
  }
}
